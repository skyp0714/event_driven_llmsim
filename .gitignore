# Ignore env file
env/

# Ignore python cache
*.pyc
__pycache__/
.pytest_cache/
*.joblib

# Ignore pkl files
*.pkl

# Ignore bench results
bench/results/
/results/hbf-evaluation/

# AI agent cache files
.claude/
.codex/
.cursor/
.copilot/
.aider*
.continue/

# Campaign cell outputs are large and regenerable; aggregates are committed.
results/*/cells/

# Campaign run logs written to the repo root by the experiments/ drivers.
# Pure stdout; the aggregates under experiments/*/ are the durable record.
/*.log
